# ---------------------------------------------------------------
# KrishiSense AI — environment variables
# Copy this file to `.env` and fill in values.
# The platform boots with ONLY DATABASE_URL. Everything else is
# optional — the app degrades gracefully when keys are absent.
# ---------------------------------------------------------------

# REQUIRED — PostgreSQL connection (local Postgres or Supabase)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# OPTIONAL — Supabase (if you host the DB on Supabase instead)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OPTIONAL integrations — never required for core operation
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Weather + geocoding (Open-Meteo, Nominatim) need NO keys.
